# Пример конфигурации. Скопируйте в .env и при необходимости измените:
#   cp .env.example .env
#   task run
# Файл .env подхватывает Taskfile. Сам сервис читает только переменные окружения
# и .env не загружает; без task: set -a; source .env; set +a; go run ./cmd/server

# Адрес HTTP-сервера
#HTTP_ADDR=:8080
HTTP_PORT=8080
HOST_HTTP_PORT=8090

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# Таймауты HTTP-сервера и остановки (формат Go: 5s, 1m)
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Postgres в docker compose. Compose подставляет их в docker-compose.yml.
# Compose лежит в корне и читает этот же .env (подстановки и env_file сервиса app).
POSTGRES_PORT=5432
HOST_POSTGRES_PORT=5482
#POSTGRES_USER=iptv
#POSTGRES_PASSWORD=iptv
#POSTGRES_DB=iptv

# Подключение к БД для запуска без docker (порт совпадает с HOST_POSTGRES_PORT).
# В docker compose адрес собирается в docker-compose.yml.
# DATABASE_URL=postgres://iptv:iptv@localhost:5442/iptv?sslmode=disable
DB_CONNECT_TIMEOUT=30s
DB_MAX_CONNECTIONS=10

# Режим: dev | prod (по умолчанию dev). В dev при каждом старте запускается сидер
# с демо-данными (alice, bob, каналы). Админ создаётся миграцией в любом режиме.
# В prod сидер выключен, а STREAM_SIGNING_KEY обязателен.
APP_ENV=dev

# Ограничение одновременных проверок паролей argon2id (по умолчанию GOMAXPROCS).
# Каждая занимает около 19 МиБ памяти. При нехватке слота за HASH_WAIT_TIMEOUT сервис отвечает 503.
#HASH_CONCURRENCY=4
HASH_WAIT_TIMEOUT=2s

# Адрес стрим-сервера (cmd/stream): к нему добавляется stream_path канала в ответе playback.
STREAM_BASE_URL=http://localhost:8081
# Где слушает учебный стрим-сервер (локальный запуск) и порты в docker compose.
#STREAM_HTTP_ADDR=:8081
STREAM_PORT=8081
HOST_STREAM_PORT=8081
# ffmpeg крутит этот ролик по кругу на всех каналах, рисуя в углу название канала.
# Название рисует фильтр ass (libass): локальный ffmpeg без libass крутит ролик без названия,
# в docker-образе всё есть.
#FFMPEG_BIN=ffmpeg
#STREAM_SOURCE_FILE=docs/sample-10s-vp9.mp4
# Семейство шрифта с кириллицей и (по желанию) каталог со шрифтами для libass.
#STREAM_FONT_FAMILY=DejaVu Sans
#STREAM_FONTS_DIR=
# ffmpeg канала запускается по первому запросу и останавливается без зрителей через это время.
#STREAM_IDLE_TIMEOUT=30s
#STREAM_START_TIMEOUT=15s
# Секрет HMAC для подписи ссылок на потоки. В dev можно не задавать (используется
# небезопасный ключ по умолчанию). В prod обязателен, не короче 32 байт, например:
#   openssl rand -hex 32
#STREAM_SIGNING_KEY=
# Срок действия подписанной ссылки на поток (формат Go: 5m, 90s)
STREAM_TOKEN_TTL=5m
