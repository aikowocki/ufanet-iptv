          ] } }]
        },
        {
          "name": "405: неверный метод",
          "request": { "method": "POST", "url": "{{base_url}}/api/v1/channels" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('405', () => pm.response.to.have.status(405));",
            "pm.test('Allow', () => pm.expect(pm.response.headers.has('Allow')).to.be.true);",
            "pm.test('JSON-ошибка', () => pm.expect(pm.response.json().error.code).to.eql('method_not_allowed'));"
          ] } }]
