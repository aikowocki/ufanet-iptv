          ] } }]
        },
        {
          "name": "400: некорректный id",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/channels/abc/playback" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('JSON-ошибка', () => pm.expect(pm.response.json().error).to.have.property('message'));"
          ] } }]
        },
        {
          "name": "Список каналов: bob (есть недоступные)",
          "request": {
            "auth": { "type": "basic", "basic": [
              { "key": "username", "value": "bob", "type": "string" },
              { "key": "password", "value": "bob12345", "type": "string" }
            ] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/channels"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const locked = pm.response.json().channels.filter(c => !c.available);",
            "pm.test('есть каналы без подписки', () => pm.expect(locked).to.not.be.empty);",
            "if (locked.length) pm.collectionVariables.set('locked_channel_id', locked[0].id);"
          ] } }]
        },
        {
          "name": "403: канал без подписки (bob)",
          "request": {
            "auth": { "type": "basic", "basic": [
              { "key": "username", "value": "bob", "type": "string" },
              { "key": "password", "value": "bob12345", "type": "string" }
            ] },
            "method": "GET",
            "url": "{{base_url}}/api/v1/channels/{{locked_channel_id}}/playback"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));",
            "pm.test('forbidden', () => pm.expect(pm.response.json().error.code).to.eql('forbidden'));",
            "pm.test('нет ссылки в ответе', () => pm.expect(pm.response.json()).to.not.have.property('url'));"
          ] } }]
        },
        {
          "name": "404: несуществующий канал",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/channels/999999/playback" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));",
            "pm.test('JSON-ошибка', () => pm.expect(pm.response.json().error.code).to.eql('not_found'));"
          ] } }]
        },
        {
          "name": "404: неизвестный путь",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/nope" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));",
