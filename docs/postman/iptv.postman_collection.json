    {
      "name": "Админка",
      "description": "Сквозной сценарий админ-API. Запускать папкой целиком (Runner): запросы связаны переменными run_id, new_*_id. Данные не удаляются, а выключаются в конце. Нужна учётка администратора: admin_login/admin_password.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{admin_login}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{admin_password}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "403: обычный пользователь",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/users",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{login}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('код forbidden', () => pm.expect(pm.response.json().error.code).to.eql('forbidden'));"
                ]
              }
            }
          ]
        },
        {
          "name": "401: без авторизации",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/users",
            "auth": {
