        },
        {
          "name": "Пользователь: создать",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/admin/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"login\": \"pm_{{run_id}}\", \"password\": \"Passw0rd-{{run_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('run_id', String(Date.now() % 900000 + 10000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('new_user_id', String(b.id));",
                  "pm.test('поля', () => pm.expect(b).to.have.all.keys('id', 'login', 'is_active', 'is_admin'));",
                  "pm.test('по умолчанию активен, не админ', () => { pm.expect(b.is_active).to.be.true; pm.expect(b.is_admin).to.be.false; });",
                  "pm.test('нет пароля и хэша в ответе', () => { const t = pm.response.text(); pm.expect(t).to.not.include('password'); pm.expect(t).to.not.include('argon2'); });"
                ]
              }
            }
          ]
        },
